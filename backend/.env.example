# backend/.env — local development configuration.
# Copy this file to backend/.env and fill in the values.
# NEVER commit the filled-in version — .gitignore already excludes backend/.env.
# On Render/Railway, don't use this file at all: set these in the host's
# environment dashboard instead (render.yaml prompts for each one).

# ── Required: Discord OAuth2 (member login) ──────────────────────────────────
# Discord Developer Portal → your application → OAuth2
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Must EXACTLY match a redirect registered in the portal (including http/https)
DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/discord/callback

# Right-click your server icon → Copy Server ID (Developer Mode must be on)
DISCORD_GUILD_ID=

# ── Required: session signing ────────────────────────────────────────────────
# Freshly generated random value — fine to use as-is for local dev.
# Generate a DIFFERENT one for production (openssl rand -hex 32); anyone
# holding this string can forge sessions.
JWT_SECRET=5b12156b035569755ce8df14df1dc422d7c4c0ac9895ced971de6ba23ad143bb

# ── Required: Supabase ───────────────────────────────────────────────────────
# Project Settings → API. The SERVICE ROLE key, not the anon key.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ── Strongly recommended ─────────────────────────────────────────────────────
# Bot page → Reset Token. Without it: no slash commands, no rosters, no voice
# snapshots, and kicked members keep site access until their session expires.
# ⚠️ Leave this BLANK in local dev if production is running with the same bot —
# two gateway connections on one token fight over slash-command interactions.
DISCORD_BOT_TOKEN=

# Comma-separated role IDs. Admin roles hold every capability, always.
DISCORD_ADMIN_ROLE_IDS=
# Empty = any server member may log in
DISCORD_ALLOWED_ROLE_IDS=

# Google AI Studio key — screenshot parsing (match scoreboards, gear levels).
# Without it, CSV upload still works; screenshot upload errors cleanly.
GEMINI_API_KEY=

# ── Optional: Discord channels the bot posts to ──────────────────────────────
DISCORD_ROSTER_CHANNEL_ID=
DISCORD_LOA_CHANNEL_ID=
DISCORD_ANNOUNCE_CHANNEL_ID=
# Roles counted as "member" for rosters/attendance (defaults to ALLOWED roles)
DISCORD_MEMBER_ROLE_IDS=

# ── Guild Hall staff: who operates the PLATFORM, not any one guild ───────────
# Gates the public Americas threat board (/threat-board), whose alliance map is
# one shared record every visitor reads and no guild owns. Deliberately env-only
# so no tenant's admin page can promote someone to operating the platform.
#
# Preferred: a role in the Guild Hall HQ Discord server. The bot must be in that
# server for the check to work. Add someone to the role and they can edit.
GUILD_HALL_STAFF_GUILD_ID=
GUILD_HALL_STAFF_ROLE_ID=
# Bootstrap and lifeboat: Discord user ids that are always staff, comma
# separated. Needs no bot and keeps working when Discord is unreachable — which
# is exactly when the role check would otherwise lock you out of your own board.
GUILD_HALL_STAFF_IDS=

# ── Optional: the wargame fill pool's own host ───────────────────────────────
# The full origin of the merc subdomain, e.g. https://merc.guild-hall.gg (or
# http://merc.localhost:5173 for local dev). This server answers on it too,
# serving only the fill pool, and people who belong to no guild here can sign
# in on it. Register <MERC_ORIGIN>/api/auth/discord/callback as a second
# redirect on the Discord application. Leave empty to have no merc host — the
# fill pages still exist inside the guild app. See backend/sites.js.
MERC_ORIGIN=

# Guild Hall staff channel for the fill pool. When a leader submits or changes a
# leader claim on merc, the bot posts it here for staff to review. The bot must
# be in that server and able to see and send in the channel. Leave empty to
# post nothing. Deployment config, not per-guild — like GUILD_HALL_STAFF_*.
FILLS_STAFF_CHANNEL_ID=

# ── Optional: tuning (defaults shown, uncomment to change) ───────────────────
# APP_URL=/
# GEMINI_MODEL=gemini-2.5-flash
# GEAR_SUBMIT_LIMIT_PER_HOUR=5
# SESSION_REVERIFY_MINUTES=60
# MEMBER_CACHE_SECONDS=60
# IDENTITY_CACHE_SECONDS=30
# WEAPON_LEGEND_PATH=./assets/weapon_legend.png
# CORS_ORIGINS=
# PORT=3000
# NODE_ENV=production   # set in production only — enables Secure cookies
